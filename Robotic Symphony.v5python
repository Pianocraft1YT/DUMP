{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nmotor_5 = Motor(Ports.PORT5, GearSetting.RATIO_18_1, False)\nmotor_1 = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nmotor_8 = Motor(Ports.PORT8, GearSetting.RATIO_18_1, False)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\nimport random\n# Begin project code\ndef half_note():\n    wait(0.5,SECONDS)\ndef quarter_note():\n    wait(0.2,SECONDS)\ndef eighth_note():\n    wait(0.1,SECONDS)\n\nmotor_5.set_position(0,DEGREES)\nmotor_1.set_position(0,DEGREES)\nmotor_8.set_position(0,DEGREES)\n\n\ndef firstSet():\n\n    motor_5.set_velocity(65,PERCENT)\n    motor_1.set_velocity(65,PERCENT)\n    motor_8.set_velocity(65,PERCENT)\n    motor_5.spin_to_position(16,DEGREES)\n    motor_1.spin_to_position(11,DEGREES)\n    motor_8.spin_to_position(16,DEGREES)\n    motor_1.spin(REVERSE)\n    quarter_note()\n    motor_1.spin_to_position(16,DEGREES)\n    quarter_note()\n    motor_1.stop()\n    motor_5.spin(REVERSE)\n    quarter_note()\n    motor_5.spin_to_position(16,DEGREES)\n    quarter_note()\n    motor_5.stop()\n    motor_8.spin(REVERSE)\n    quarter_note()\n    motor_8.spin_to_position(11,DEGREES)\n    quarter_note()\n    motor_8.stop()\n\ndef secondSet():\n    motor_8.set_position(50,DEGREES)\n    motor_5.set_position(50,DEGREES)\n    motor_8.set_velocity(100,PERCENT)\n    motor_5.set_velocity(100,PERCENT)\n    motor_8.spin(REVERSE)\n    eighth_note()\n    motor_8.spin_to_position(0,DEGREES)\n    motor_5.spin_to_position(0,DEGREES)\n    eighth_note()\n    motor_8.stop()\n    motor_8.spin(REVERSE)\n    eighth_note()\n    motor_8.spin_to_position(0,DEGREES)\n    eighth_note()\n    motor_8.stop()\n    motor_8.spin(REVERSE)\n    eighth_note()\n    motor_8.spin_to_position(0,DEGREES)\n    eighth_note()\n    motor_8.stop()\n    motor_8.spin(REVERSE)\n    eighth_note()\n    motor_8.spin_to_position(0,DEGREES)\n    eighth_note()\n    motor_8.stop()\n    motor_8.spin(REVERSE)\n    eighth_note()\n    motor_8.spin_to_position(0,DEGREES)\n    eighth_note()\n    motor_8.stop()\n    motor_5.spin(REVERSE)\n    eighth_note()\n    motor_5.spin_to_position(0,DEGREES)\n    eighth_note()\n    motor_5.stop()\n    motor_5.spin(REVERSE)\n    eighth_note()\n    motor_5.spin_to_position(0,DEGREES)\n    eighth_note()\n    motor_5.stop()\n    motor_5.spin(REVERSE)\n    eighth_note()\n    motor_5.spin_to_position(0,DEGREES)\n    eighth_note()\n    motor_5.stop()\n    motor_5.spin(REVERSE)\n    eighth_note()\n    motor_5.stop()\n\n\nfirstSet()\nwait(.3,SECONDS)\nfirstSet()\nwait(.2,SECONDS)\n\nsecondSet()\nfirstSet()","textLanguage":"python","robotConfig":[{"port":[5],"name":"motor_5","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[3],"name":"led_c","customName":false,"deviceType":"LED","deviceClass":"led","setting":{},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}
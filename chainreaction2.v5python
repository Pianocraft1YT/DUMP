{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nleft_drive_smart = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nright_drive_smart = Motor(Ports.PORT2, GearSetting.RATIO_18_1, True)\ndrivetrain = DriveTrain(left_drive_smart, right_drive_smart, 319.19, 295, 40, MM, 1)\ndistance_3 = Distance(Ports.PORT3)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# Library imports\nfrom vex import *\n\n# Begin project code\n\n# Variables\n\nnoCollision = True #sets the initial loop state\ndistance_sensor = Distance(Ports.PORT3) #construct distance sensor\npmeter = PotentiometerV2(brain.three_wire_port.a) #construct all meters and switches\nbswitch = Bumper(brain.three_wire_port.b)\nlswitch = Limit(brain.three_wire_port.c)\n# Functions\ndef checkDistance(): #function for less repeated code\n    currentDistance = distance_sensor.object_distance(MM) #gets the current distance away from object\n    wait(30, MSEC)\n    if currentDistance <= 200:\n        global noCollision #use global to modify the first variable\n        noCollision = False #we are too close, stop the loop\n        drivetrain.stop() #stop the motors\n        wait(1, SECONDS)\n    else: \n        drivetrain.drive(FORWARD) #if not close, move forward for a second\n        wait(1, SECONDS)\n        drivetrain.stop() #stop to check again\ndef printScreen(): #function for printing values of all switches and meters\n    brain.screen.clear_screen() #clear previous values\n    brain.screen.set_cursor(1,1) #set cursor to first position\n    brain.screen.print(\"Potentiometer: \" + str(pmeter.angle(PERCENT))) #print the value of the potentiometer\n    brain.screen.set_cursor(2, 1) #set cursor to second pos\n    brain.screen.print(\"Bump Switch: \" + str(bswitch.pressing())) #print value\n    brain.screen.set_cursor(3,1) #set to third pos\n    brain.screen.print(\"Limit Switch: \" + str(lswitch.pressing())) #print value\n    brain.screen.set_cursor(4,1) #set to fourth pos\n    brain.screen.print(\"Distance: \" + str(distance_sensor.object_distance(MM))) #print current distance\n# Body of code\ndrivetrain.set_drive_velocity(10, PERCENT) #set initial speed \nonoff = -1 #PLTW requirement for turning on motors\n\nwhile (True):\n    printScreen() #call print function\n    distance = distance_sensor.object_distance(MM)\n    angle = pmeter.angle(PERCENT) #set the variable for the potentiometer's value\n    wait(50,MSEC) #PLTW requirement for correctly printing\n    drivetrain.set_drive_velocity(angle, PERCENT) #set the motors velocity whatever value potentiometer is at\n    if (bswitch.pressing() != 0 or lswitch.pressing() != 0): #check for both switches being on\n        onoff = 1 #set value of should spin motors or not\n    else:\n        onoff = -1 #if we do -onoff, it could be -1 going to 1 so absolute is better\n    if (onoff == 1): #if we want the motor to move then execute this code\n        if (distance <= 300): #check if we are close to the other group\n            if (angle < 10): #if the value of potentiometer is less than 10 percent, we probably don't want it to move, so don't move still\n                drivetrain.stop() #stops it if moving\n            else:\n                drivetrain.drive(FORWARD) #we want to stop after X amount and break the loops.\n                wait(1,SECONDS)\n                drivetrain.stop() \n                break\n        else: #runs if we aren't close enough\n            if (angle < 10): #same as above\n                drivetrain.stop() #same as above\n            else:\n                drivetrain.drive(FORWARD) #keep driving as we aren't close enough        \n    else:\n        drivetrain.stop() #stop if onoff is false\n        \n    wait(300, MSEC) #wait before checking again","textLanguage":"python","robotConfig":[{"port":[1,2,null],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"wheel4in","gear":"ratio18_1","gearRatio":"1:1","direction":"fwd","gyroType":"none","width":"295","unit":"mm","wheelbase":"40","wheelbaseUnit":"mm","xOffset":"0","xOffsetUnit":"mm","yOffset":"0","yOffsetUnit":"mm","thetaOffset":"180"},"triportSourcePort":null},{"port":[3],"name":"distance_3","customName":false,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22}],"slot":1,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.62.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}
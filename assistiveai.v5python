{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbumper_a = Bumper(brain.three_wire_port.a)\nbumper_b = Bumper(brain.three_wire_port.b)\nbumper_c = Bumper(brain.three_wire_port.c)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\ngo = False #initial state of do not move\nturning_motor = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False) #instantiate motor\nturning_motor.set_position(0,DEGREES) #set initial angle\nturning_motor.set_velocity(30,PERCENT)\ndef printScreen(): #function for printing values of all switches and meters\n    brain.screen.clear_screen() #clear previous values\n    brain.screen.set_cursor(1,1) #set cursor to first position\n    brain.screen.print(\"Bumper A: \" + str(bumper_a.pressing())) #print current button values\n    brain.screen.set_cursor(2,1)\n    brain.screen.print(\"Bumper B: \" + str(bumper_b.pressing()))\n    brain.screen.set_cursor(3,1)\n    brain.screen.print(\"Bumper C: \" + str(bumper_c.pressing()))\ndef check_buttons(): #checks if any button has been pressed\n    global go #changes the global variable go\n    b = bumper_b.pressing() #assign values to compare if they are on\n    c = bumper_c.pressing()\n    a = bumper_a.pressing()\n    if (a == 1): #compare\n        turning_motor.set_velocity(100, PERCENT) #set speed based on which button was pressed\n        go = True #we are ready to go\n    elif (b == 1):\n        turning_motor.set_velocity(60,PERCENT)\n        go = True\n    elif (c == 1):\n        turning_motor.set_velocity(30,PERCENT)\n        go = True\n    \n\n\nwhile True:\n    printScreen() #loop functions\n    check_buttons()\n    if (go): #if time to go, wind back then hit the ball, then reset to initial position\n        turning_motor.spin_to_position(90,DEGREES)\n        turning_motor.spin_to_position(-30,DEGREES)\n        turning_motor.spin_to_position(0,DEGREES)\n        brain.screen.set_cursor(4,1)\n        brain.screen.print(\"Moving! \")\n        go = False #don't go again until ready","textLanguage":"python","robotConfig":[{"port":[1],"name":"bumper_a","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[2],"name":"bumper_b","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[3],"name":"bumper_c","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22}],"slot":2,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.64.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}